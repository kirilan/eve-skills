# The dashboard web server as a systemd user service. Install (see README, `dashboard`):
#   cp contrib/systemd/eve-dashboard.service ~/.config/systemd/user/
#   edit the two /path/to/eve-tools paths below, and --since if the operation started elsewhere
#   systemctl --user daemon-reload && systemctl --user enable --now eve-dashboard.service
# It runs the code of the checkout it points at: restart it after pulling or switching branches.
[Unit]
Description=eve-skills: profitability, jobs and orders dashboard on port 8765 (local network)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/to/eve-tools
ExecStart=/path/to/eve-tools/.venv/bin/python -m eve_skills dashboard serve --host 0.0.0.0 --port 8765 --refresh 60 --since 2026-09-19
Restart=on-failure
RestartSec=30
Nice=10

[Install]
WantedBy=default.target
